-- 시드: Trino 의 tpch 커넥터로 생성한 데이터를 Iceberg 테이블로 굳힌다.
-- 이후 Trino 와 StarRocks 는 "같은 파일"을 읽는다 — 데이터 차이로 인한 비교 오염이 없다.
-- @TPCH@ 는 bin/seed.sh 가 프로파일의 TPCH_SCHEMA(tiny | sf1)로 치환한다.
--
-- ★ CTAS 에 컬럼 별칭을 다는 이유: Trino tpch 커넥터의 컬럼명에는 TPC-H 표준 접두어가
--   없다(orderkey, shipdate ...). 표준 이름(l_orderkey, l_shipdate ...)으로 굳혀야
--   TPC-H 명세나 StarRocks 벤치마크의 쿼리를 손대지 않고 그대로 쓸 수 있다.
--   각 문장은 반드시 한 줄이어야 한다 — seed.sh 가 줄 단위로 실행한다.

CREATE SCHEMA IF NOT EXISTS iceberg.bench WITH (location = 's3://lakehouse/bench');

CREATE TABLE IF NOT EXISTS iceberg.bench.nation (n_nationkey, n_name, n_regionkey, n_comment) AS SELECT nationkey, name, regionkey, comment FROM tpch.@TPCH@.nation;
CREATE TABLE IF NOT EXISTS iceberg.bench.region (r_regionkey, r_name, r_comment) AS SELECT regionkey, name, comment FROM tpch.@TPCH@.region;
CREATE TABLE IF NOT EXISTS iceberg.bench.supplier (s_suppkey, s_name, s_address, s_nationkey, s_phone, s_acctbal, s_comment) AS SELECT suppkey, name, address, nationkey, phone, acctbal, comment FROM tpch.@TPCH@.supplier;
CREATE TABLE IF NOT EXISTS iceberg.bench.part (p_partkey, p_name, p_mfgr, p_brand, p_type, p_size, p_container, p_retailprice, p_comment) AS SELECT partkey, name, mfgr, brand, type, size, container, retailprice, comment FROM tpch.@TPCH@.part;
CREATE TABLE IF NOT EXISTS iceberg.bench.partsupp (ps_partkey, ps_suppkey, ps_availqty, ps_supplycost, ps_comment) AS SELECT partkey, suppkey, availqty, supplycost, comment FROM tpch.@TPCH@.partsupp;
CREATE TABLE IF NOT EXISTS iceberg.bench.customer (c_custkey, c_name, c_address, c_nationkey, c_phone, c_acctbal, c_mktsegment, c_comment) AS SELECT custkey, name, address, nationkey, phone, acctbal, mktsegment, comment FROM tpch.@TPCH@.customer;
CREATE TABLE IF NOT EXISTS iceberg.bench.orders (o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate, o_orderpriority, o_clerk, o_shippriority, o_comment) AS SELECT orderkey, custkey, orderstatus, totalprice, orderdate, orderpriority, clerk, shippriority, comment FROM tpch.@TPCH@.orders;
CREATE TABLE IF NOT EXISTS iceberg.bench.lineitem (l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment) AS SELECT orderkey, partkey, suppkey, linenumber, quantity, extendedprice, discount, tax, returnflag, linestatus, shipdate, commitdate, receiptdate, shipinstruct, shipmode, comment FROM tpch.@TPCH@.lineitem;

ANALYZE iceberg.bench.nation;
ANALYZE iceberg.bench.region;
ANALYZE iceberg.bench.supplier;
ANALYZE iceberg.bench.part;
ANALYZE iceberg.bench.partsupp;
ANALYZE iceberg.bench.customer;
ANALYZE iceberg.bench.orders;
ANALYZE iceberg.bench.lineitem;
