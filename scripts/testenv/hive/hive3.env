# Hive Metastore 변형: 3.1.3
#
#   기동: bin/up.sh --hive 3        (hive 4 로 떠 있는 상태면 거부된다)
#   전환: bin/reset.sh --hive 3     (볼륨을 지우고 다시 — 스키마가 호환되지 않는다)
#
# 왜 이 변형이 필요한가:
#   실무에 남아 있는 HMS 상당수가 아직 Hive 3 계열이다. Iceberg 카탈로그 동작이 HMS
#   메이저 버전에 걸리는지(테이블 등록, 통계, 파티션 API) 확인하려면 3.1.3 에서도
#   같은 비교 쿼리가 돌아야 한다.
#
# Hive 4 대비 달라지는 점과 그 대응 위치 — 전부 확인·해결됨.
# 이 레이어를 왜 분리했는지는 plan/02 의 D-7 참조.
#
#   | 차이                                          | 대응                              | 구현 위치            |
#   |-----------------------------------------------|-----------------------------------|----------------------|
#   | arm64 매니페스트 없음 (amd64 단독)            | 플랫폼 고정 + 메모리 2배 보정     | 아래 HMS_PLATFORM,   |
#   |                                               |                                   | common.sh            |
#   | 번들 Hadoop 이 3.1.0 (4.x 는 3.3.6)           | hadoop-aws/aws-sdk 를 맞춰 주입   | 아래 버전값,         |
#   |                                               |                                   | conf/hms/Dockerfile  |
#   | postgresql-9.4 드라이버 동봉 (SCRAM 미지원)   | 제거하고 42.7.4 만 남김           | conf/hms/Dockerfile  |
#   | schematool 이 매번 -initSchema (멱등하지 않음)| 기존 스키마 감지 시 건너뜀        | hms-entrypoint.sh    |
#   | schematool 이 metastore-site.xml 을 못 읽음   | 같은 파일을 hive-site.xml 로 복사 | hms-entrypoint.sh    |
#
# ★ 에뮬레이션이므로 HMS 왕복이 포함된 시간을 성능 근거로 쓰지 말 것.
#   기능 검증에는 문제없다 — HMS 는 메타데이터만 다루고 데이터 IO 는 엔진이 직접 한다.

HIVE_VARIANT=3
HIVE_VERSION=3.1.3
HIVE_BASE_IMAGE=apache/hive:3.1.3@sha256:d102ba29ad07e93c303894896203a80b903c0001d80221f1cb9fea92dcac06e4

# arm64 매니페스트 없음 (2026-08-20 확인: 단일 amd64 매니페스트).
# 이 값이 있으면 common.sh 가 "고정된 플랫폼"으로 보고, 호스트와 다를 때 HMS_MEM 을 2배로 올린다.
HMS_PLATFORM=linux/amd64

# 번들 Hadoop 버전에 맞춘 값. 어긋나면 S3A 가 런타임에 깨진다.
#   확인법: docker run --rm --platform linux/amd64 --entrypoint sh apache/hive:3.1.3 \
#             -c 'ls /opt/hive/lib | grep hadoop-common-'   → hadoop-common-3.1.0.jar
HADOOP_AWS_VERSION=3.1.0
# hadoop-project-3.1.0.pom 의 <aws-java-sdk.version>
AWS_SDK_BUNDLE_VERSION=1.11.271
