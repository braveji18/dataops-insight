# Hive Metastore 변형: 4.0.1 (기본값)
#
#   기동: bin/up.sh              (기본값이라 --hive 4 생략 가능)
#   전환: bin/reset.sh --hive 4  (hive 3 으로 떠 있던 경우)
#
# 왜 hive/ 레이어가 따로 있는가:
#   Hive 버전을 바꾸면 이미지 태그 하나가 아니라 최소 4개 값이 함께 움직인다
#   (이미지 → 번들 Hadoop → hadoop-aws → aws-sdk, 그리고 아키텍처 지원 범위).
#   손으로 맞추면 반드시 어긋나므로 한 세트를 파일 하나로 묶는다. 설계 근거는 plan/02 D-7.
#
# hive 3 대비 이쪽이 단순한 이유 — 특별 대응이 필요한 항목이 없다:
#   멀티아치 이미지라 에뮬레이션이 없고, schematool 이 -initOrUpgradeSchema 라 재기동에
#   멱등하며, metastore-site.xml 을 직접 읽는다. hms-entrypoint.sh 의 hive 3 분기는
#   HIVE_MAJOR=4 일 때 통째로 건너뛴다.
#
# ★ 변형을 바꾸면 HMS 백엔드 DB 스키마가 호환되지 않는다(Hive 3 → 3.1.0, Hive 4 → 4.0.0).
#   반드시 bin/reset.sh --hive N 으로 볼륨째 갈아야 한다. up.sh 가 그냥은 거부한다.

HIVE_VARIANT=4
HIVE_VERSION=4.0.1
HIVE_BASE_IMAGE=apache/hive:4.0.1@sha256:5194161ef50b80875f937dff04936df047cbe894e9727ab8f0606349345b1bd3

# HMS_PLATFORM 을 일부러 두지 않는다 = 멀티아치(amd64/arm64) 이미지라는 뜻이고,
# common.sh 가 호스트 아키텍처를 채워 넣는다. 에뮬레이션 메모리 보정도 걸리지 않는다.

# 번들 Hadoop 버전에 맞춘 값. 어긋나면 S3A 가 런타임에 깨진다.
#   확인법: docker run --rm --entrypoint sh apache/hive:4.0.1 \
#             -c 'ls /opt/hive/lib | grep hadoop-common-'   → hadoop-common-3.3.6.jar
HADOOP_AWS_VERSION=3.3.6
# hadoop-project-3.3.6.pom 의 <aws-java-sdk.version>
AWS_SDK_BUNDLE_VERSION=1.12.367
