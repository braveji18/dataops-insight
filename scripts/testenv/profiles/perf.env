# perf 프로파일 — 상대 성능 비교용
#
# 목적: 같은 호스트에서 두 엔진의 상대 시간 비교. 절대값은 운영 환경으로 이전 불가.
# 데이터: TPC-H SF 1 (lineitem 약 600만 행, Iceberg/Parquet 약 250MB).
# 요구 자원: Docker 16GB 이상 + 여유 디스크 10GB.
#
# ★ 경고: Apple Silicon(arm64)에서 StarRocks BE 는 NEON 경로, x86 에서는 AVX2/AVX512
#   경로를 탄다. arm64 랩의 성능 숫자를 x86 운영 환경 판단 근거로 쓰지 말 것.
#   bench.sh 가 결과 파일에 호스트 아키텍처를 항상 기록하는 이유다.

LAB_PROFILE=perf
TPCH_SCHEMA=sf1

# 힙 = mem_limit * 0.8 (이미지 jvm.config 기본값)
TRINO_COORD_MEM=2000m
TRINO_WORKER_MEM=4000m
TRINO_QUERY_MAX_MEMORY=2GB
TRINO_QUERY_MAX_MEMORY_PER_NODE=1000MB

SR_FE_MEM=2500m
SR_FE_HEAP=2048m
SR_BE_MEM=4000m
SR_BE_MEM_LIMIT=3200M

HMS_MEM=1g
PG_MEM=512m
MINIO_MEM=768m

# 합계 약 14.8GB. Docker 에 16GB 이상 할당돼 있어야 여유가 생긴다.

LAB_MIN_DOCKER_MEM_BYTES=16000000000
