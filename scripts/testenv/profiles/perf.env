# perf 프로파일 — 상대 성능 비교용
#
# 목적: 같은 호스트에서 두 엔진의 상대 시간 비교.
# 데이터: TPC-H SF 1 (lineitem 약 600만 행, Iceberg/Parquet 약 250MB).
# 요구 자원: Docker 16GB 이상 + 여유 디스크 10GB.
#
# ★ 절대값은 운영 환경으로 이전 불가. worker 1대 / BE 1대이고, Apple Silicon(arm64)에서
#   StarRocks BE 는 NEON 경로를, x86 에서는 AVX2/AVX512 경로를 탄다. 같은 쿼리라도
#   실행 코드가 다르다. bench.sh 가 결과 JSON 에 호스트 아키텍처를 항상 박는 이유다.

LAB_PROFILE=perf
TPCH_SCHEMA=sf1

# --- Trino -------------------------------------------------------------------
# 힙 = mem_limit × 0.8 (이미지 jvm.config 기본값)
TRINO_COORD_MEM=2000m
TRINO_WORKER_MEM=4000m
TRINO_QUERY_MAX_MEMORY=2GB
TRINO_QUERY_MAX_MEMORY_PER_NODE=1000MB

# --- StarRocks ---------------------------------------------------------------
SR_FE_MEM=2500m
SR_FE_HEAP=2048m
SR_BE_MEM=4000m
SR_BE_MEM_LIMIT=3200M

# --- 공통 인프라 --------------------------------------------------------------
# HMS_MEM > HMS_HEAP 은 불변식이다. 근거와 검증은 common.sh 의 lab_check_hms_mem 참조.
HMS_MEM=1536m
HMS_HEAP=1g
PG_MEM=512m
MINIO_MEM=768m

# 컨테이너 한도 합계 약 15.3GB — 16GB 이상 할당돼 있어야 여유가 생긴다.
LAB_MIN_DOCKER_MEM_BYTES=16000000000
