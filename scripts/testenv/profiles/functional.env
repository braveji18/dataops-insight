# functional 프로파일 — 기능 검증용 (기본값)
#
# 목적: plan/01 의 비교 축에 대한 "동작하는가 / 어떻게 동작하는가" 확인.
#       플랜 모양, 푸시다운 여부, 에러 메시지, SQL 방언 차이, 결과 정합성.
# 데이터: TPC-H SF 0.01 (tiny). lineitem 약 6만 행.
# 요구 자원: Docker 8GB 이상.
#
# ★ 이 프로파일의 시간 수치는 성능 근거로 인용 금지. 데이터가 너무 작아 대부분
#   CLI 접속 오버헤드에 묻힌다. 성능 비교는 perf 프로파일을 쓸 것.

LAB_PROFILE=functional
TPCH_SCHEMA=tiny

# --- Trino -------------------------------------------------------------------
# 힙 = mem_limit × 0.8 (이미지 jvm.config 의 -XX:MaxRAMPercentage=80).
# query.max-memory-per-node 는 (힙 − heap-headroom 30%) 이하여야 기동한다.
TRINO_COORD_MEM=1600m
TRINO_WORKER_MEM=2000m
TRINO_QUERY_MAX_MEMORY=1GB
TRINO_QUERY_MAX_MEMORY_PER_NODE=600MB

# --- StarRocks ---------------------------------------------------------------
# FE 는 JVM(SR_FE_HEAP), BE 는 C++ 자체 메모리 관리(SR_BE_MEM_LIMIT).
# 둘 다 컨테이너 한도(*_MEM)보다 작아야 한다.
SR_FE_MEM=1600m
SR_FE_HEAP=1024m
SR_BE_MEM=2200m
SR_BE_MEM_LIMIT=1800M

# --- 공통 인프라 --------------------------------------------------------------
# HMS_MEM > HMS_HEAP 은 불변식이다. 근거와 검증은 common.sh 의 lab_check_hms_mem 참조.
# (에뮬레이션으로 뜨는 경우 up.sh 가 HMS_MEM 을 자동으로 2배로 올린다)
HMS_MEM=1280m
HMS_HEAP=1g
PG_MEM=256m
MINIO_MEM=512m

# up.sh 가 기동 전에 검사하는 Docker 총 메모리 하한(바이트).
LAB_MIN_DOCKER_MEM_BYTES=8000000000
