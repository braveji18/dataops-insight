# =============================================================================
# lakehouse-lab 버전 기준선 (single source of truth)
#
# 이 파일 하나가 테스트 환경 전체의 버전을 지배한다.
#   - 컨테이너 이미지 (digest 고정)
#   - works/ 에 클론하는 소스 태그 (WORKS_*_REF)
# 둘은 반드시 일치해야 한다. 이 저장소는 런타임 증거(쿼리 결과)로 코드 증거(works/ 경로:라인)를
# 검증하는 구조라, 어긋나면 docs/ 의 주장이 검증 불가능해진다.
#
# 버전 올리는 절차:
#   1) 이 파일 수정  2) works/ 재클론  3) bin/reset.sh  4) docs/ 상단 버전 표기 갱신
#   ★ reset 없이 볼륨을 남기면 이전 버전 메타데이터가 섞여 조용히 이상 동작한다.
#
# 예외 — Hive Metastore 는 여기에 없다:
#   HMS 는 "비교 대상"이 아니라 두 엔진에 동일 조건으로 제공되는 인프라다. 게다가 버전을
#   바꾸면 이미지 태그 하나가 아니라 hadoop-aws / aws-sdk / 아키텍처까지 세트로 움직인다.
#   그래서 hive/hive3.env, hive/hive4.env 로 분리했다. 선택: bin/up.sh --hive 3|4
#
# digest 해결 시각: 2026-08-20 / linux/amd64 + linux/arm64 멀티아치 확인 완료
# =============================================================================

# --- 비교 대상 A: Trino -------------------------------------------------------
TRINO_VERSION=483
TRINO_IMAGE=trinodb/trino:483@sha256:db58cc93e593a2706553745f276bb119c9810e69918be56ecde088ba7ccb0534

# --- 비교 대상 B: StarRocks ---------------------------------------------------
# 4.0.1 이 아니라 4.0.14 인 이유: 4.0.1 BE 는 Trino 가 쓴 Iceberg Parquet 의 DATE 컬럼에
# 술어를 걸면 row-group zone-map 필터 경로에서 SIGSEGV 로 죽는다(재현 확인).
# 근거와 재현 절차: docs/evidence/A-5/20260820-starrocks-4.0.1-parquet-date-zonemap-crash.md
STARROCKS_VERSION=4.0.14
STARROCKS_FE_IMAGE=starrocks/fe-ubuntu:4.0.14@sha256:fad7faecc3cf6ae55b4d150cd51769a3e2e2ba1c5a6a75c8c844d828f72f27ae
STARROCKS_BE_IMAGE=starrocks/be-ubuntu:4.0.14@sha256:ba115c16331a2500085f7b3493e9d883d89c191f70fbf02e8db59d30b4185688

# --- works/ 클론 태그 ---------------------------------------------------------
# 스크립트가 읽지 않는다. 위 이미지와 짝을 이루는 소스 태그를 한 곳에 적어두기 위한 값이다.
#   git clone --depth 1 --branch $WORKS_TRINO_REF      https://github.com/trinodb/trino.git       works/trino
#   git clone --depth 1 --branch $WORKS_STARROCKS_REF  https://github.com/StarRocks/starrocks.git works/starrocks
WORKS_TRINO_REF=483
WORKS_STARROCKS_REF=4.0.14

# --- 공통 인프라 (비교 대상 아님, 양쪽에 동일 조건으로 제공) -------------------
POSTGRES_IMAGE=postgres:16@sha256:e17e86066e5ef83e0952a9347f5c792b7ece00972e2aa787a6986f471b3dd3d5
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
CURL_IMAGE=curlimages/curl:8.11.1@sha256:c1fe1679c34d9784c1b0d1e5f62ac0a79fca01fb6377cdd33e90473c6f9f9a69

# HMS 커스텀 이미지에 주입할 postgres JDBC (hive 3/4 공통).
# PostgreSQL 16 기본 인증이 SCRAM-SHA-256 이라 이를 지원하는 버전이어야 한다.
POSTGRES_JDBC_VERSION=42.7.4

# 기본 Hive 변형. bin/up.sh --hive 3 으로 덮어쓴다.
LAB_HIVE_DEFAULT=4

# --- 랩 고정 상수 -------------------------------------------------------------
# ★ 아래 값들은 환경변수 치환이 안 되는 파일에도 하드코딩돼 있다. 바꾸려면 4곳을 함께 고칠 것:
#     conf/hms/metastore-site.xml
#     conf/trino/catalog/iceberg.properties
#     sql/00-starrocks-catalog.sql
#     이 파일
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=lakehouse
# 양쪽 엔진에 동일한 이름으로 등록되는 Iceberg 카탈로그 이름.
# 이름을 맞췄기 때문에 같은 SQL 문자열이 두 엔진에서 그대로 돈다.
ICEBERG_CATALOG=iceberg
BENCH_SCHEMA=bench
